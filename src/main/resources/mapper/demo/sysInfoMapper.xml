<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zhaofd.demomybatisweb.modules.demo.repository.SysInfoRepository">
    <!-- cache -->

    <!-- cache-ref -->

    <!-- resultMap -->

    <!-- sql -->
    <sql id="columns">
        id, name, rcreatetime, rupdatetime
    </sql>

    <!-- insert -->
    <insert id="save">
        <selectKey keyProperty="id" resultType="string" order="BEFORE" statementType="PREPARED">
            select replace(uuid(), '-', '') as uuid
        </selectKey>
        insert into sys_info(id, name, rcreatetime, rupdatetime)
        values (#{id}, #{name}, #{rcreatetime}, #{rupdatetime})
    </insert>

    <!-- delete -->

    <!-- update -->

    <!-- select -->
    <select id="findById" resultType="sysInfo">
        select
        <include refid="columns"/>
        from sys_info where id = #{id}
    </select>

    <!-- procedure -->

    <!-- function -->

</mapper>
